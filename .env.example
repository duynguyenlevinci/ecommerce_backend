# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGIN=*
PUBLIC_URL=http://localhost:3000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=ecommerce
DB_SYNCHRONIZE=true
DB_LOGGING=false

# JWT
JWT_SECRET=change-me-please-use-a-strong-random-secret
JWT_EXPIRES_IN=30d
# Hard maximum lifetime: tokens older than this (from iat) will be rejected
# AND all other tokens of the same user will be invalidated.
JWT_MAX_AGE_DAYS=30

# Bcrypt
BCRYPT_SALT_ROUNDS=10

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# MoMo Payment (sandbox credentials below — replace with production keys)
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=F8BBA842ECF85
MOMO_SECRET_KEY=K951B6PE1waDMi640xX08PD3vg6EkVlz
MOMO_REDIRECT_URL=http://localhost:3000/payment/result
MOMO_IPN_URL=http://localhost:3000/api/v1/payment/momo/ipn
MOMO_REQUEST_TYPE=payWithMethod
